# ══════════════════════════════════════════════════
# 复制这个文件为 .env，然后填入你自己的 API Key
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# ══════════════════════════════════════════════════

# 必填：你的 LLM API Key（不要用别人的，也不要提交 .env）
CONTRACTNET_API_KEY=

# 接口地址（按你的服务商填）
#   DeepSeek: https://api.deepseek.com/v1
#   OpenAI:   https://api.openai.com/v1
#   智谱GLM:  https://open.bigmodel.cn/api/paas/v4
CONTRACTNET_BASE_URL=https://api.deepseek.com/v1

# 默认模型名
CONTRACTNET_MODEL=deepseek-chat

# 可选：裁判模型（用于质量门控，建议与执行模型不同）
CONTRACTNET_JUDGE_MODEL=
